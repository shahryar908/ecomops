# Default: treat as text and normalize to LF on commit + checkout
* text=auto eol=lf

# Explicit text files (shell scripts and Dockerfiles must stay LF for Linux containers)
*.js          text eol=lf
*.jsx         text eol=lf
*.ts          text eol=lf
*.tsx         text eol=lf
*.json        text eol=lf
*.yml         text eol=lf
*.yaml        text eol=lf
*.md          text eol=lf
*.html        text eol=lf
*.css         text eol=lf
*.sh          text eol=lf
*.sql         text eol=lf
*.tf          text eol=lf
Dockerfile    text eol=lf
.gitignore    text eol=lf
.gitattributes text eol=lf
.dockerignore text eol=lf
.env.example  text eol=lf

# Binary files — never alter these
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.svg   binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.pdf   binary
*.zip   binary
*.tar.gz binary
